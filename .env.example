# ==============================================================================
# QatlIA Environment Variables Configuration
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# 1. Supabase Configuration (Database & Auth & Storage)
# ------------------------------------------------------------------------------
# Récupérer sur : https://supabase.com/dashboard/project/<PROJECT_ID>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 2. OpenAI Configuration (Vision IA GPT-4o mini)
# ------------------------------------------------------------------------------
# Récupérer sur : https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# 3. Stripe Configuration (Paiements & Packs de Crédits)
# ------------------------------------------------------------------------------
# Devise de règlement : MAD (dirham marocain), en minuscules côté Stripe ("mad").
# Les prix affichés et les montants débités proviennent tous les deux de
# src/lib/billing/catalog.ts — il n'y a aucun ID de prix Stripe à configurer,
# les line items sont construits dynamiquement (priceMAD * 100 centimes).
# Le compte Stripe doit donc accepter les paiements en MAD.
#
# Récupérer sur : https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Récupérer sur : https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# ------------------------------------------------------------------------------
# 4. Creem Configuration (paiements internationaux par carte, en USD)
# ------------------------------------------------------------------------------
# Creem est Merchant of Record : il encaisse en USD et reverse sur un compte
# bancaire marocain. Quand CREEM_API_KEY et les 4 produits sont renseignés,
# le bouton « carte » passe par Creem (prioritaire sur Stripe).
#
# La clé détermine l'environnement : creem_test_... -> test-api.creem.io,
# creem_live_... -> api.creem.io. Les produits test et live ont des ID différents.
# Les prix des produits Creem doivent être égaux à priceUSD dans
# src/lib/billing/catalog.ts (c'est le prix affiché sous le bouton carte).
#
# Récupérer sur : https://creem.io/dashboard/developers
CREEM_API_KEY=creem_test_your_creem_api_key
# Récupérer sur : Developers > Webhooks, URL https://<domaine>/api/credits/creem-webhook
# (en local : `creem listen --forward-to http://localhost:3001/api/credits/creem-webhook`
#  affiche un secret temporaire)
CREEM_WEBHOOK_SECRET=whsec_your_creem_webhook_secret_here
CREEM_PRODUCT_STARTER=prod_your_starter_product_id
CREEM_PRODUCT_STANDARD=prod_your_standard_product_id
CREEM_PRODUCT_PRO=prod_your_pro_product_id
CREEM_PRODUCT_ATELIER_MAX=prod_your_atelier_max_product_id
